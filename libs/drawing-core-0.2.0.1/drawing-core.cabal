
cabal-version: 1.12

name:           drawing-core
version:        0.2.0.1
--- description:    Please see the README on GitHub at <https://github.com/githubuser/drawing#readme>
author:         Jordi Forga Alberich
maintainer:     jordi.forga@upc.edu
copyright:      2022 Jordi Forga-Alberich
license:        BSD3
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md
    test/AC.png
    test/test2.hs

library
  exposed-modules:
      Drawing
      Drawing.DataUri
      Drawing.IO
      Drawing.Render
      Drawing.Types
      Drawing.Vector
  hs-source-dirs:
    src
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns
    -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
    base >=4.7 && <5
    , aeson
    , bytestring
    , base64-bytestring
    , text
  if !impl(ghcjs) && !arch(javascript)
    build-depends:
      template-haskell
    default-extensions:
      TemplateHaskell
    cpp-options:
      -DEMBEDING
  default-language: Haskell2010

test-suite test1
  type:
    exitcode-stdio-1.0
  main-is:
    test/test1.hs
  build-depends:
    base >=4.7 && <5
    , drawing-core
  default-language: Haskell2010

