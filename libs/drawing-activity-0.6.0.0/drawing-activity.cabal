cabal-version: 3.0

name:           drawing-activity
version:        0.6.0.0
--- description:    Please see the README on GitHub at <https://github.com/githubuser/drawing#readme>
author:         Jordi Forga Alberich
maintainer:     jordi.forga@upc.edu
copyright:      2022 Jordi Forga-Alberich
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple

extra-source-files:
    static/index.html

flag TestStableNamed
  Description: Test the equality of StableNamed values.
               To enable this flag from 'stack', enter:
                 'stack build --flag drawing-activity:TestStableNamed'
  Default:     False
  Manual:      True

flag Tracing
  Description: Print the debug messages.
               To enable this flag from 'stack', enter:
                 'stack build --flag drawing-activity:Tracing'
  Default:     False
  Manual:      True

library
  exposed-modules:
    Drawing.Activity
    Drawing.Activity.Element
  hs-source-dirs:
      src
  build-depends:
    base >=4.7 && <5,
    containers,
    drawing-core >=0.2,
    fluid >=0.1 && <0.2,
    mtl,
    text,
    web-apis >= 0.1
  if flag(TestStableNamed)
    CPP-Options: -DTEST_STABLENAMED
  if flag(Tracing)
    CPP-Options: -DTRACING
  default-language:
    Haskell2010

